{
  "expo": {
    "name": "Motif",
    "slug": "motif",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/motif-icon.png",
    "scheme": "motif",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/motif-icon.png",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050507",
        "foregroundImage": "./assets/images/motif-foreground.png",
        "monochromeImage": "./assets/images/motif-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/motif-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050507"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
